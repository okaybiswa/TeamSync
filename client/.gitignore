# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# TeamSync project-specific exclusions
/client/node_modules/
/server/node_modules/
/client/.next/
/client/out/
/server/dist/
/client/dist/

# Prisma local/generated files and environment secrets
/server/.env
/client/.env.local

# Protect backend environment and dependencies
/server/.env
/server/.env.*
/server/node_modules/

# Protect frontend environment and dependencies
/client/.env
/client/.env.*
/client/node_modules/
